# ---------------------------------------------------------------------------
# Copia este fichero a .env y ajusta los valores. NUNCA subas .env al repo.
# ---------------------------------------------------------------------------

# Entorno de ejecución: development | production
APP_ENV=development

# Nombre visible de la aplicación
APP_NAME=Gestor de Presupuesto

# Clave para firmar los tokens de sesión. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos PostgreSQL (en EasyPanel usa el host del servicio de Postgres)
DATABASE_URL=postgresql+asyncpg://presupuesto:presupuesto@localhost:5432/presupuesto

# Orígenes permitidos por CORS, separados por comas.
# En producción, con el frontend servido por el propio backend, puede quedar vacío.
CORS_ORIGINS=http://localhost:5173

# Duración de los tokens
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Cookies de sesión: en producción con HTTPS debe ser true
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Proxies de los que se acepta la cabecera X-Forwarded-For, separados por comas.
# Importa para la seguridad: esa cabecera la puede escribir cualquiera, y es la
# clave con la que se cuentan los intentos de acceso. Si se creyera siempre,
# bastaría con cambiarla en cada intento para saltarse el límite.
#
# En local, vacío. Detrás del proxy de EasyPanel hay que declararlo o el límite
# de intentos contará todas las peticiones como si vinieran de la misma IP —la
# del proxy—, y un solo visitante podría agotar el cupo de los demás. Acepta
# direcciones concretas o "*" para confiar en cualquier par (solo si el
# contenedor no está expuesto directamente a internet).
TRUSTED_PROXIES=

# Almacenamiento de las facturas subidas
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=40

# OCR opcional para facturas escaneadas (requiere tesseract instalado)
OCR_ENABLED=true
OCR_LANGUAGES=spa+eng

# Permitir el registro de nuevos usuarios. Ponlo en false si eres el único usuario.
ALLOW_REGISTRATION=true

# Localización por defecto
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=es-ES
DEFAULT_TIMEZONE=Europe/Madrid
